---
// Mark: a six-arm snowflake whose branches all lean one way, so it reads as a fan (cold air). Source: src/assets/logo-mark.svg
// (public/favicon.svg is a copy; keep them in sync). Wordmark colours come from the surrounding band (--fg, --accent).
import mark from '../assets/logo-mark.svg?raw';
---
<span class="logo">
  <span class="mark" aria-hidden="true" set:html={mark} />
  <span class="word"><span class="blue">Blue</span><span class="frost">Frost</span></span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--fg); }
  .mark, .mark :global(svg) { width: 32px; height: 32px; }
  .mark { flex: none; border-radius: 8px; box-shadow: 0 0 0 1px var(--line); }
  .word { font-size: 1.375rem; letter-spacing: -0.04em; line-height: 1; }
  .blue { font-weight: 800; }
  .frost { font-weight: 500; color: var(--accent); }
</style>
