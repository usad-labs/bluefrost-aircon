---
import Icon from './Icon.astro';
import { trustClaims } from '../data/site';
---
<section class="band band-light trust" aria-label="Why choose BlueFrost">
  <div class="container">
    <ul>
      {trustClaims.map((c) => (
        <li><Icon name={c.icon} size={28} /><span>{c.text}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust { padding-block: var(--space-6) var(--space-12); }
  ul { display: grid; gap: var(--space-6) var(--space-4); grid-template-columns: 1fr 1fr; }
  li { display: grid; gap: var(--space-3); align-content: start; font-weight: 700; line-height: 1.3; }
  li :global(svg) { color: var(--accent); }
  @media (min-width: 768px) {
    .trust { padding-block: var(--space-8) var(--space-16); }
    ul { grid-template-columns: repeat(4, 1fr); gap: var(--space-8); }
  }
</style>
