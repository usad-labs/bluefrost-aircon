---
import Icon from './Icon.astro';
import { trustClaims } from '../data/site';
---
<section class="band band-dark trust" aria-label="Why choose BlueFrost">
  <div class="container">
    <ul>
      {trustClaims.map((c) => (
        <li><Icon name={c.icon} size={32} /><span>{c.text}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust { --bg: var(--navy-2); padding-block: var(--strip-pad); }
  /* phones: 2 x 2, icon above text */
  ul { display: grid; gap: var(--space-6) var(--space-4); grid-template-columns: 1fr 1fr; }
  li { display: grid; gap: var(--space-3); align-content: start; font-weight: 700; line-height: 1.3; }
  li :global(svg) { color: var(--accent); }
  /* 600-999px: still 2 x 2, but icon beside text so each item is two lines at most */
  @media (min-width: 600px) {
    ul { gap: var(--space-6) var(--space-8); }
    li { grid-template-columns: auto 1fr; align-items: center; }
  }
  /* 1000px and up: four across with dividers */
  @media (min-width: 1000px) {
    ul { grid-template-columns: repeat(4, 1fr); gap: var(--space-6); }
    li + li { padding-left: var(--space-6); border-left: 1px solid var(--line); }
  }
</style>
