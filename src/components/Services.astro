---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { services } from '../data/services';
import { formatPeso } from '../data/pricing';
import { site } from '../data/site';
---
<section class="band band-light" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head">
      <h2 id="services-title">Everything your aircon needs</h2>
      <p>Four services, one team, one clear price before we start.</p>
    </div>
    <ul class="cards">
      {services.map((s) => (
        <li>
          <div class="media">
            <div class="shot">
              <Picture src={s.image} alt={s.alt} formats={['avif', 'webp']} widths={[448, 672, 896]} width={896} height={672} sizes="(min-width: 1100px) 282px, (min-width: 600px) calc(50vw - 56px), calc(100vw - 48px)" loading="lazy" decoding="async" />
            </div>
            <span class="badge" aria-hidden="true"><Icon name={s.icon} size={28} /></span>
          </div>
          <div class="body">
            <h3>{s.name}</h3>
            <p class="benefit">{s.benefit}</p>
            <p class="detail">{s.detail}</p>
            <a class="price" href="#pricing">
              <strong>{s.from ? `from ${formatPeso(s.from)}` : 'Quoted first'}</strong>
              <span class="go">{s.from ? 'See packages' : 'See pricing'} <Icon name="arrow-right" size={20} /></span>
            </a>
          </div>
        </li>
      ))}
    </ul>
    <div class="ask">
      <p>Not sure which one you need?</p>
      <a class="btn btn-secondary" href={site.messengerUrl} target="_blank" rel="noopener" aria-label={site.messengerAriaLabel}>
        <Icon name="message" size={20} /> {site.messengerLabel}
      </a>
    </div>
  </div>
</section>

<style>
  /* 1 column on phones, 2 from 600px, 4 from 1100px: never an orphan card. Cards stretch, so every price row lines up. */
  .cards { display: grid; gap: var(--grid-gap); }
  li { display: flex; flex-direction: column; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-photo); }
  .media { position: relative; }
  .shot { aspect-ratio: 16 / 10; overflow: hidden; border-radius: calc(var(--radius-photo) - 1px) calc(var(--radius-photo) - 1px) 0 0; background: var(--navy-2); }
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%; }
  /* the badge overlaps the photo edge: a white ring cuts it out of both, a short navy shadow lifts it */
  .badge {
    position: absolute; left: var(--space-6); bottom: -28px; display: grid; place-items: center; width: 56px; height: 56px;
    border-radius: 50%; background: var(--navy); color: var(--cyan); box-shadow: 0 0 0 4px var(--white), var(--shadow-float);
  }
  .body { display: flex; flex: 1; flex-direction: column; gap: var(--space-2); padding: var(--space-12) var(--space-6) var(--space-6); }
  .benefit { font-weight: 600; }
  .detail { color: var(--muted); margin-bottom: var(--space-4); }
  .price {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); margin-top: auto; min-height: 44px;
    padding-top: var(--space-4); border-top: 1px solid var(--line); color: var(--fg); text-decoration: none;
  }
  .price strong { font-size: var(--t-h3); font-weight: 800; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }
  .go { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--link); font-weight: 700; }
  .price:hover .go { text-decoration: underline; text-underline-offset: 4px; }
  .ask { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); margin-top: var(--space-6); font-weight: 600; }

  @media (min-width: 600px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1100px) {
    .cards { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .shot { aspect-ratio: 4 / 3; }
    .body { padding: 40px var(--space-4) var(--space-4); }
    .detail { margin-bottom: var(--space-2); }
    .badge { left: var(--space-4); }
    /* narrow cards: price above, link below, so the row never wraps unevenly */
    .price { flex-direction: column; align-items: flex-start; justify-content: center; gap: 0; padding-top: var(--space-3); }
    .go { font-size: var(--t-small); gap: var(--space-1); }
  }
</style>
