---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { faq } from '../data/faq';
import { site } from '../data/site';
import techFace from '../assets/v3/tech-face.jpg'; // 250px crop of svc-repair.jpg, so a 64px face stays sharp
---
<section class="band band-light" id="faq" aria-labelledby="faq-title">
  <div class="container faq">
    <div class="side">
      <h2 id="faq-title">Questions we often hear</h2>
      <p class="intro">Straight answers before you book.</p>
      <div class="help">
        <div class="who">
          <span class="face">
            <Picture src={techFace} alt="BlueFrost technician (AI-generated photo)" formats={['avif', 'webp']} widths={[64, 128]} width={64} height={64} sizes="64px" loading="lazy" decoding="async" />
          </span>
          <div>
            <h3>Talk to a technician</h3>
            <p class="hours"><span class="nb">{site.hours}</span> <span class="nb">(sample)</span></p>
          </div>
        </div>
        <div class="actions">
          <a class="tel" href={site.phoneHref}><Icon name="phone" size={24} /> {site.phoneDisplay}</a>
          <a class="btn btn-secondary" href={site.messengerUrl} target="_blank" rel="noopener" aria-label={site.messengerAriaLabel}>
            <Icon name="message" size={20} /> {site.messengerLabel}
          </a>
        </div>
      </div>
    </div>
    <div class="list">
      {faq.map((item, i) => (
        <details open={i === 0}>
          <summary>
            <span>{item.q}</span>
            <span class="plus"><Icon name="plus" size={20} /></span>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { display: grid; gap: var(--space-8); }
  /* trim the heading's line-box above the capitals, so its top lines up with the first card's top edge (browsers without text-box-trim still align the boxes) */
  h2 { text-box: trim-start cap alphabetic; }
  .intro { margin-top: var(--space-4); color: var(--muted); }
  .help { display: grid; gap: var(--space-4); margin-top: var(--space-8); padding: var(--space-6); background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-card); }
  .who { display: flex; align-items: center; gap: var(--space-4); }
  .face { flex: none; width: 64px; height: 64px; overflow: hidden; border-radius: 50%; background: var(--navy-2); }
  .face :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hours { font-size: var(--t-small); color: var(--muted); }
  /* below 360px the hours may wrap anywhere: a nowrap line would push the card past the screen edge */
  @media (min-width: 360px) { .nb { white-space: nowrap; } }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-6); padding-top: var(--space-4); border-top: 1px solid var(--line); }
  .tel { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; font-size: var(--t-h3); font-weight: 800; white-space: nowrap; color: var(--fg); }
  .tel :global(svg) { color: var(--accent); }

  /* equal gaps between the cards; the list fills the column */
  .list { display: grid; gap: var(--space-3); }
  details { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-card); }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
    min-height: 64px; padding: var(--space-4) var(--space-4) var(--space-4) var(--space-6);
    border-radius: calc(var(--radius-card) - 1px); cursor: pointer; font-weight: 600; font-size: var(--t-h3); line-height: 1.3; list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  /* the ring sits inside the card, so the rounded corners never clip it */
  summary:focus-visible { outline-offset: -4px; }
  .plus { display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 50%; background: var(--bg); color: var(--accent); }
  .plus :global(svg) { display: block; }
  /* + turns into x when the card opens */
  details[open] .plus { background: var(--fg); color: var(--white); }
  details[open] .plus :global(svg) { transform: rotate(45deg); }
  @media (prefers-reduced-motion: no-preference) {
    .plus, .plus :global(svg) { transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1), background-color 150ms ease-out, color 150ms ease-out; }
  }
  @media (hover: hover) and (pointer: fine) {
    summary:hover .plus { background: var(--line); }
    details[open] summary:hover .plus { background: var(--navy-hover); }
  }
  details p { padding: 0 var(--space-6) var(--space-6); max-width: 65ch; }
  @media (min-width: 600px) and (max-width: 899px) {
    /* one wide card above the list: photo and title left, actions right, so neither half sits empty */
    .help { grid-template-columns: auto 1fr; align-items: center; column-gap: var(--space-8); }
    .actions { justify-content: flex-end; padding-top: 0; border-top: 0; }
  }
  @media (min-width: 900px) {
    /* the left column sticks while the list scrolls past it */
    .faq { grid-template-columns: 5fr 7fr; gap: var(--head-gap); }
    .side { position: sticky; top: var(--space-6); align-self: start; }
  }
</style>
