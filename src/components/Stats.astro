---
import { Picture } from 'astro:assets';
import { stats } from '../data/stats';
import trustPhoto from '../assets/v3/svc-repair.jpg';
---
<section class="band band-dark stats" aria-label="BlueFrost in numbers (sample data)">
  <div class="bg-photo">
    <Picture src={trustPhoto} alt="" formats={['avif', 'webp']} widths={[480, 720, 896]} width={896} height={672} sizes="(min-width: 768px) 100vw, 700px" loading="lazy" decoding="async" />
  </div>
  <div class="container">
    <h2>Eight years of cold rooms in Cavite</h2>
    <ul>
      {stats.map((s) => (
        <li><strong>{s.value}</strong><span>{s.label}</span></li>
      ))}
    </ul>
    <p class="note">Sample numbers, invented for this demo.</p>
  </div>
</section>

<style>
  .stats { position: relative; isolation: isolate; overflow: hidden; --scrim: linear-gradient(180deg, rgb(11 21 48 / 0.82) 0%, rgb(11 21 48 / 0.78) 100%); }
  .bg-photo :global(img) { object-position: 62% 25%; }
  h2 { max-width: 16ch; }
  ul { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8) var(--space-4); margin-top: var(--head-gap); }
  li { display: grid; gap: var(--space-2); align-content: start; padding-top: var(--space-4); border-top: 2px solid var(--accent); }
  strong { font-size: var(--t-h2); font-weight: 800; letter-spacing: -0.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  span { font-weight: 500; line-height: 1.3; }
  .note { margin-top: var(--space-6); font-size: var(--t-small); }
  @media (min-width: 768px) {
    ul { grid-template-columns: repeat(4, 1fr); gap: var(--grid-gap); }
    .bg-photo :global(img) { object-position: 50% 22%; }
  }
</style>
