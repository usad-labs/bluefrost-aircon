---
import { icons, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  size?: number;
  filled?: boolean;
}
const { name, size = 24, filled = false } = Astro.props;
---
<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={filled ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {icons[name].map((d) => <path d={d} />)}
</svg>
