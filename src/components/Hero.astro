---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../data/site';
import heroImage from '../assets/v3/hero.jpg';
---
<section class="band band-dark hero" aria-labelledby="hero-title">
  <div class="bg-photo">
    <Picture src={heroImage} alt="Technician on a stepladder servicing a wall-mounted split aircon" formats={['avif', 'webp']} widths={[480, 720, 960, 1344]} width={1344} height={768} sizes="(min-width: 900px) 100vw, max(100vw, 630px)" loading="eager" fetchpriority="high" decoding="async" />
  </div>
  <div class="container inner">
    <div class="copy">
      <h1 id="hero-title">Aircon weak? We fix it.</h1>
      <p class="lead">Noisy, leaking or barely cooling? Most visits finish the same day, with the price agreed first and a <span class="nb">90-day</span> warranty.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={site.phoneHref}><Icon name="phone" size={20} /> {site.quoteLabel}</a>
        <a class="btn btn-secondary msg" href={site.messengerUrl} target="_blank" rel="noopener" aria-label={site.messengerAriaLabel}>
          <Icon name="message" size={20} /> {site.messengerLabel}
        </a>
      </div>
    </div>
    <div class="proof">
      <span class="score" role="img" aria-label="Rated 4.9 out of 5"><strong>4.9</strong> <Icon name="star" size={18} filled /></span>
      <span class="count"><strong>2,400+</strong> aircons serviced <span class="nb">(sample)</span></span>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; padding-block: 0; }
  /* Phones: the photo fills the top 360px and fades into navy; the text sits on the faded part, so the scrim is strong there. */
  .bg-photo { inset: 0 0 auto 0; height: 360px; --scrim: linear-gradient(180deg, rgb(11 21 48 / 0.2) 0%, rgb(11 21 48 / 0.55) 35%, rgb(11 21 48 / 0.92) 68%, var(--navy) 100%); }
  .bg-photo :global(img) { object-position: 82% 30%; }
  .inner { position: relative; padding-block: 188px var(--section-pad); }
  .copy { display: grid; gap: var(--space-4); }
  .nb { white-space: nowrap; }
  .lead { font-size: var(--t-body); font-weight: 500; line-height: 1.5; max-width: 34rem; }
  .copy .btn-row { gap: var(--space-2); margin-top: var(--space-2); }
  /* Phones: a compact two-line card on the dark left, so it does not cover the unit in the photo. */
  .proof {
    position: absolute; left: var(--gutter); top: var(--space-4); max-width: 10.5rem;
    display: grid; gap: var(--space-1); padding: var(--space-3) var(--space-4);
    background: var(--white); color: var(--navy); border-radius: var(--radius-card); box-shadow: var(--shadow-float);
    font-size: var(--t-small); line-height: 1.3;
  }
  .score { display: inline-flex; align-items: center; gap: var(--space-1); font-size: var(--t-h3); }
  .score :global(svg) { color: var(--cyan-deep); }
  .count strong { font-weight: 800; }

  /* Phones: one big button; "Message us" becomes a plain link (the sticky bar still has both). */
  @media (max-width: 767px) {
    .msg { min-height: 44px; padding-inline: 0; border-color: transparent; color: var(--link); text-decoration: underline; text-underline-offset: 4px; }
    .msg:hover { background: transparent; }
  }

  @media (min-width: 768px) {
    .lead { font-size: var(--t-h3); }
  }

  /* Desktop: the photo is full bleed, the headline sits on the dark left, and a left-to-right navy scrim keeps it readable. */
  @media (min-width: 900px) {
    .bg-photo { inset: 0; height: auto; --scrim: linear-gradient(90deg, var(--navy) 0%, rgb(11 21 48 / 0.94) 28%, rgb(11 21 48 / 0.7) 46%, rgb(11 21 48 / 0.2) 62%, rgb(11 21 48 / 0) 78%); }
    .bg-photo :global(img) { object-position: 0% 15%; }
    .inner { display: grid; align-content: center; min-height: clamp(540px, 44vw, 680px); padding-block: var(--section-pad); }
    .copy { max-width: 33rem; gap: var(--space-6); }
    .hero h1 { font-size: clamp(3rem, 6.2vw, 5rem); }
    .proof { left: auto; right: var(--gutter); top: auto; bottom: var(--head-gap); max-width: none; display: flex; align-items: center; gap: var(--space-3); }
    .score { padding-right: var(--space-3); border-right: 1px solid var(--line-light); }
  }
</style>
