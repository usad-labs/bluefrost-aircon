---
import { site } from '../data/site';
---
<footer class="band band-dark">
  <div class="container">
    <div class="cols">
      <div>
        <h2>{site.name}</h2>
        <p>{site.tagline}</p>
      </div>
      <div>
        <h3>Contact (sample)</h3>
        <p><a href={site.phoneHref}>{site.phoneDisplay}</a></p>
        <p>{site.hours}</p>
      </div>
      <div>
        <h3>Service area</h3>
        <p>{site.serviceArea.join(', ')}</p>
      </div>
    </div>
    <p class="fine">BlueFrost Aircon is a fictional business. All names, numbers, prices and reviews are sample data.</p>
    <p class="fine">Built by USAD Labs · Connect. Automate. Accelerate.</p>
  </div>
</footer>

<style>
  .cols { display: grid; gap: var(--space-8); grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  h2 { font-size: 1.5rem; }
  h3 { font-size: 1rem; margin-bottom: var(--space-2); }
  p { color: var(--muted); }
  a { display: inline-block; padding-block: var(--space-2); color: var(--link); font-weight: 600; }
  .fine { margin-top: var(--space-4); font-size: 0.875rem; }
  .cols + .fine { margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid rgba(191, 219, 254, 0.35); }
</style>
