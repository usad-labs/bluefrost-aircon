---
import { clientLogos } from '../data/site';
---
<section class="band band-white logos" aria-labelledby="logos-title">
  <div class="container">
    <h2 id="logos-title">Trusted by homes and small businesses across Cavite</h2>
    <ul>
      {clientLogos.map((name, i) => <li class={`w${i % 3}`}>{name}</li>)}
    </ul>
    <p class="note">Sample client names, invented for this demo.</p>
  </div>
</section>

<style>
  .logos { padding-block: var(--space-8); border-top: 1px solid var(--blue-200); }
  h2 { font-size: 1rem; font-weight: 600; letter-spacing: 0; color: var(--muted); text-align: center; }
  ul { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-4) var(--space-8); margin-top: var(--space-6); }
  /* Greyscale text wordmarks; three styles so they read as different brands. */
  li { color: var(--slate); font-size: 1.125rem; }
  .w0 { font-weight: 800; letter-spacing: -0.03em; }
  .w1 { font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.9375rem; }
  .w2 { font-weight: 700; font-style: italic; }
  .note { margin-top: var(--space-4); text-align: center; font-size: 0.875rem; color: var(--muted); }
</style>
