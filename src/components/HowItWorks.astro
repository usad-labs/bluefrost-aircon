---
const steps = [
  { title: 'Book in one tap', text: 'Call or message us. Tell us the problem and the type of unit.' },
  { title: 'Get a clear price', text: 'We confirm the price before any work starts. No surprises.' },
  { title: 'Enjoy a cold room', text: 'We clean or repair on the day, test the cooling and cover it with a 90-day warranty.' },
];
---
<section class="band band-white" aria-labelledby="how-title">
  <div class="container">
    <div class="section-head">
      <h2 id="how-title">How it works</h2>
    </div>
    <ol class="grid">
      {steps.map((s) => (
        <li>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  ol { counter-reset: step; }
  li { counter-increment: step; display: grid; gap: var(--space-2); align-content: start; }
  li::before {
    content: counter(step); display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: var(--space-2);
    border-radius: 50%; background: var(--blue-900); color: var(--white); font-weight: 700; font-size: 1.125rem;
  }
  p { color: var(--muted); }
</style>
