---
const steps = [
  { title: 'Book in one tap', text: 'Call or message us. Tell us the problem and the type of unit.' },
  { title: 'Get a clear price', text: 'We confirm the price before any work starts. No surprises.' },
  { title: 'Enjoy a cold room', text: 'We clean or repair on the day, test the cooling and cover it with a 90-day warranty.' },
];
---
<section class="band band-white" aria-labelledby="how-title">
  <div class="container how">
    <div class="section-head">
      <h2 id="how-title">How it works</h2>
      <p>Three steps from a warm room to a cold one.</p>
    </div>
    <ol>
      {steps.map((s) => (
        <li>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how { display: grid; gap: var(--space-8); }
  .section-head { margin-bottom: 0; }
  /* a vertical line links the steps: the order matters here */
  ol { counter-reset: step; display: grid; gap: var(--space-8); position: relative; }
  ol::before { content: ''; position: absolute; left: 21px; top: 22px; bottom: 22px; width: 2px; background: var(--line); }
  li { counter-increment: step; display: grid; gap: var(--space-2); position: relative; padding-left: 72px; }
  li::before {
    content: counter(step); position: absolute; left: 0; top: -4px; display: grid; place-items: center; width: 44px; height: 44px;
    border-radius: 50%; background: var(--navy); color: var(--cyan); font-weight: 800; font-size: var(--t-h3);
  }
  p { color: var(--muted); max-width: 36rem; }
  @media (min-width: 900px) {
    .how { grid-template-columns: 5fr 7fr; gap: var(--space-12); }
  }
</style>
