---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import stepsPhoto from '../assets/v3/svc-install.jpg';
const steps = [
  { icon: 'phone', title: 'Book in one tap', text: 'Call or message us. Tell us the problem and the type of unit.' },
  { icon: 'badge-check', title: 'Get a clear price', text: 'We confirm the price before any work starts. No surprises.' },
  { icon: 'snowflake', title: 'Enjoy a cold room', text: 'We clean or repair on the day, test the cooling and cover it with a 90-day warranty.' },
] as const;
---
<section class="band band-white" id="how-it-works" aria-labelledby="how-title">
  <div class="container how">
    <div class="photo">
      <div class="shot">
        <Picture src={stepsPhoto} alt="Two technicians mounting a split aircon on a bedroom wall" formats={['avif', 'webp']} widths={[448, 672, 896]} width={896} height={672} sizes="(min-width: 900px) 520px, calc(100vw - 32px)" loading="lazy" decoding="async" />
      </div>
      <p class="chip"><Icon name="shield-check" size={24} /> <span>90-day warranty on every job</span></p>
    </div>
    <div class="text">
      <div class="section-head">
        <h2 id="how-title">How it works</h2>
        <p>Three steps from a warm room to a cold one.</p>
      </div>
      <ol>
        {steps.map((s, i) => (
          <li>
            <span class="ico" aria-hidden="true"><Icon name={s.icon} size={26} /><span class="n">{i + 1}</span></span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .how { display: grid; gap: var(--head-gap); }
  .photo { position: relative; margin-bottom: var(--space-6); } /* room for the chip that hangs below the photo */
  .shot { position: relative; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 24px; background: var(--navy-2); }
  .shot :global(picture) { display: contents; }
  .shot :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 45% 40%; }
  /* a functional badge overlapping the photo's bottom edge */
  .chip {
    position: absolute; left: var(--space-4); bottom: -24px; display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4);
    background: var(--white); color: var(--navy); border-radius: var(--radius-card); box-shadow: var(--shadow-float); font-weight: 700; line-height: 1.3;
  }
  .chip :global(svg) { flex: none; color: var(--cyan-deep); }
  .section-head { margin-bottom: var(--head-gap); }
  @media (min-width: 600px) { .shot { aspect-ratio: 16 / 10; } }
  /* a line links the steps: the order matters here */
  ol { display: grid; gap: var(--space-8); position: relative; }
  ol::before { content: ''; position: absolute; left: 27px; top: 28px; bottom: 28px; width: 2px; background: var(--line); }
  li { display: grid; gap: var(--space-2); position: relative; padding-left: 80px; min-height: 56px; }
  .ico { position: absolute; left: 0; top: 0; display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: var(--navy); color: var(--cyan); }
  .n {
    position: absolute; top: -4px; right: -4px; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%;
    background: var(--cyan); color: var(--navy); font-size: var(--t-small); font-weight: 800; line-height: 1; box-shadow: 0 0 0 2px var(--white);
  }
  li p { color: var(--muted); max-width: 36rem; }
  @media (min-width: 900px) {
    /* the photo stretches to the height of the steps, so there is no empty gap above or below either column */
    .photo { margin-bottom: 0; }
    .how { grid-template-columns: 5fr 6fr; gap: var(--space-16); align-items: stretch; }
    .shot { aspect-ratio: auto; height: 100%; min-height: 360px; }
    .shot :global(img) { object-position: 42% 50%; }
  }
</style>
