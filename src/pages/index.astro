---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustRow from '../components/TrustRow.astro';
import LogoRow from '../components/LogoRow.astro';
import Services from '../components/Services.astro';
import Stats from '../components/Stats.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Pricing from '../components/Pricing.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import QuoteBar from '../components/QuoteBar.astro';
---
<Base
  title="BlueFrost Aircon | Aircon cleaning and repair in Cavite (sample site)"
  description="Aircon weak, noisy or leaking? BlueFrost Aircon cleans and repairs window and split units across Cavite. Sample business for a portfolio demo."
>
  <Header />
  <main id="main">
    <Hero />
    <TrustRow />
    <LogoRow />
    <Services />
    <Stats />
    <HowItWorks />
    <Pricing />
    <Reviews />
    <Faq />
    <CtaBand />
  </main>
  <Footer />
  <QuoteBar />
</Base>
